PORT=3333
NODE_ENV=development
# Lista separada por vírgula; "*.dominio" autoriza qualquer subdomínio de tenant
# (<slug>.crm-cmb.com.br) — em produção: CORS_ORIGIN=https://crm-cmb.com.br,https://*.crm-cmb.com.br
CORS_ORIGIN=http://localhost:4200,http://*.localhost:4200
DATABASE_URL=postgresql://user:password@localhost:5432/CRM
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d
META_APP_SECRET=change-me
META_WEBHOOK_VERIFY_TOKEN=change-me
# Opcional: versão da Graph API da Meta (padrão v23.0). Confira a versão vigente no painel do app.
# META_GRAPH_API_VERSION=v23.0
# "Conectar com o Facebook" (OAuth):
# META_APP_ID=                       # ID do app (Configurações > Básico, no painel da Meta)
# META_OAUTH_REDIRECT_URI=http://localhost:4200/configuracoes   # igual à URI cadastrada na Meta
# META_LOGIN_CONFIG_ID=              # Facebook Login for Business: ID da "Configuração" (sem ele, usa scope clássico)
# META_TOKEN_ENCRYPTION_KEY=         # criptografia dos tokens em repouso: openssl rand -base64 32
# Google Analytics (GA4) — conta de serviço da plataforma, opcional. Crie no Google Cloud
# (IAM > Contas de serviço > Chaves > JSON), ative a "Google Analytics Data API" no projeto e
# copie client_email e private_key do JSON. Cada cliente adiciona esse e-mail como Leitor na
# propriedade GA4 dele e informa o Property ID em Configurações.
# GA_SERVICE_ACCOUNT_EMAIL=crm-analytics@<projeto>.iam.gserviceaccount.com
# GA_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Integrador Google Ads (conversões offline dos Leads) — opcional. Cada cliente clica em
# "Conectar com o Google Ads" e autoriza com a própria conta Google. No Google Cloud da CMB:
# ative a "Data Manager API" (e a "Google Ads API"), crie um ID do cliente OAuth do tipo
# "Aplicativo da Web" e cadastre o URI de redirecionamento abaixo (tela /integrador do front).
# GOOGLE_ADS_OAUTH_CLIENT_ID=
# GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# GOOGLE_ADS_OAUTH_REDIRECT_URI=https://www.crm-cmb.com.br/integrador
# Opcional: developer token (Google Ads → Ferramentas → Central de API, no MCC da CMB). Com
# ele, contas e ações de conversão aparecem em listas; sem ele, o cliente digita os IDs.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v26
# "Esqueci minha senha" (ver shared/email/email.service.ts) — opcional: sem essa chave, o
# resto da API funciona normalmente, só o envio de e-mail de reset falha (logado, nunca
# derruba o processo). Pegue em resend.com > API Keys.
RESEND_API_KEY=change-me
EMAIL_FROM=CRM CMB <onboarding@resend.dev>
# Destino dos chamados da aba Chamados (padrão: atendimento@contentmarketingbrasil.com).
# SUPPORT_TICKET_EMAIL=atendimento@contentmarketingbrasil.com
FRONTEND_URL=https://crm-cmb.com.br
