PORT=3333
NODE_ENV=development
# Lista separada por vírgula; "*.dominio" autoriza qualquer subdomínio de tenant
# (<slug>.crm-cmb.com.br) — em produção: CORS_ORIGIN=https://crm-cmb.com.br,https://*.crm-cmb.com.br
CORS_ORIGIN=http://localhost:4200,http://*.localhost:4200
DATABASE_URL=postgresql://user:password@localhost:5432/CRM
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d
META_APP_SECRET=change-me
META_WEBHOOK_VERIFY_TOKEN=change-me
# "Esqueci minha senha" (ver shared/email/email.service.ts) — opcional: sem essa chave, o
# resto da API funciona normalmente, só o envio de e-mail de reset falha (logado, nunca
# derruba o processo). Pegue em resend.com > API Keys.
RESEND_API_KEY=change-me
EMAIL_FROM=CRM CMB <onboarding@resend.dev>
FRONTEND_URL=https://crm-cmb.com.br
