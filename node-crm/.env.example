PORT=3333
NODE_ENV=development
# Lista separada por vírgula; "*.dominio" autoriza qualquer subdomínio de tenant
# (<slug>.cmb.com) — trocar "*.localhost:4200" por "*.cmb.com" em produção.
CORS_ORIGIN=http://localhost:4200,http://*.localhost:4200
DATABASE_URL=postgresql://user:password@localhost:5432/CRM
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d
META_APP_SECRET=change-me
META_WEBHOOK_VERIFY_TOKEN=change-me
