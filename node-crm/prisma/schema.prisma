generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum TenantStatus {
    ACTIVE
    INACTIVE
}

enum UserStatus {
    ACTIVE
    INACTIVE
}

enum UserProfile {
    OWNER
    TENANT_ADMIN
    MANAGER
    USER
}

enum LeadStatus {
    NEW
    IN_PROGRESS
    CONVERTED
    LOST
}

enum CompanyStatus {
    ACTIVE
    INACTIVE
}

enum PipelineStageStatus {
    ACTIVE
    INACTIVE
}

enum DealStatus {
    IN_PROGRESS
    WON
    LOST
}

enum ActivityStatus {
    PENDING
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum DuplicateLeadStrategy {
    IGNORE
    UPDATE
}

enum MetaIntegrationLogStatus {
    RECEIVED
    PROCESSED
    DUPLICATE
    FAILED
}

model Tenant {
    id        String       @id @default(uuid()) @db.Uuid
    name      String
    tradeName String?      @map("trade_name")
    domain    String       @unique
    status    TenantStatus @default(ACTIVE)
    createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt DateTime?    @map("deleted_at") @db.Timestamptz

    users            User[]
    leads            Lead[]
    companies        Company[]
    contacts         Contact[]
    pipelines        Pipeline[]
    pipelineStages   PipelineStage[]
    deals            Deal[]
    dealStageHistory DealStageHistory[]
    activities       Activity[]
    settings         Settings?
    metaIntegration  MetaIntegration?
    metaLogs         MetaIntegrationLog[]
    widget           TenantWidget?

    @@map("tenants")
}

// Personalização white label — nome legal e domínio de login ficam em Tenant;
// aqui só o que é editável pelo próprio cliente (ver business-rules.md > Configurações).
model Settings {
    id             String    @id @default(uuid()) @db.Uuid
    tenantId       String    @unique @map("tenant_id") @db.Uuid
    logoUrl        String?   @map("logo_url")
    primaryColor   String?   @map("primary_color")
    secondaryColor String?   @map("secondary_color")
    createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
    updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

    tenant Tenant @relation(fields: [tenantId], references: [id])

    @@map("settings")
}

// Usuários com profile OWNER pertencem à plataforma (tenantId nulo) — ver multi-tenant.md.
model User {
    id           String      @id @default(uuid()) @db.Uuid
    tenantId     String?     @map("tenant_id") @db.Uuid
    name         String
    email        String
    passwordHash String      @map("password_hash")
    profile      UserProfile
    status       UserStatus  @default(ACTIVE)
    createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
    updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz

    tenant                Tenant?            @relation(fields: [tenantId], references: [id])
    leads                 Lead[]
    deals                 Deal[]
    dealStageChanges      DealStageHistory[]
    activities            Activity[]
    metaIntegrationsAsDefaultResponsible MetaIntegration[]
    widgetsAsDefaultResponsible TenantWidget[]

    @@unique([tenantId, email])
    @@index([tenantId])
    @@index([email])
    @@map("users")
}

// companyId é opcional: leads recebidos via integração (Meta Lead Ads) chegam sem
// empresa conhecida e são vinculados depois — database-patterns.md lista Lead -> Company
// como relacionamento obrigatório, mas business-rules.md não exige isso na criação.
model Lead {
    id                String     @id @default(uuid()) @db.Uuid
    tenantId          String     @map("tenant_id") @db.Uuid
    companyId         String?    @map("company_id") @db.Uuid
    responsibleUserId String     @map("responsible_user_id") @db.Uuid
    name              String
    email             String?
    phone             String?
    // cpf/location/referralSource/notes: opcionais, preenchidos quando o Lead vem do
    // widget de captação embutido no site do tenant (ver TenantWidget) — nenhum outro
    // fluxo de criação de Lead os exige.
    cpf               String?
    location          String?
    referralSource    String?    @map("referral_source")
    notes             String?    @db.Text
    status            LeadStatus @default(NEW)
    createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
    updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz

    tenant      Tenant   @relation(fields: [tenantId], references: [id])
    company     Company? @relation(fields: [companyId], references: [id])
    responsible User     @relation(fields: [responsibleUserId], references: [id])
    deal        Deal?
    activities  Activity[]
    metaLogs    MetaIntegrationLog[]

    @@index([tenantId])
    @@index([companyId])
    @@index([status])
    @@index([createdAt])
    @@map("leads")
}

model Company {
    id        String        @id @default(uuid()) @db.Uuid
    tenantId  String        @map("tenant_id") @db.Uuid
    name      String
    document  String?
    phone     String?
    email     String?
    website   String?
    street    String?
    number    String?
    district  String?
    city      String?
    state     String?
    zipCode   String?       @map("zip_code")
    country   String?
    notes     String?       @db.Text
    status    CompanyStatus @default(ACTIVE)
    createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt DateTime?     @map("deleted_at") @db.Timestamptz

    tenant   Tenant    @relation(fields: [tenantId], references: [id])
    leads    Lead[]
    contacts Contact[]
    deals    Deal[]

    @@index([tenantId])
    @@index([status])
    @@index([createdAt])
    @@map("companies")
}

// Contato pertence obrigatoriamente a uma empresa (business-rules.md > Contatos) —
// sem status próprio: o documento oficial só define nome (obrigatório), cargo,
// e-mail, telefone, celular e observações.
model Contact {
    id        String    @id @default(uuid()) @db.Uuid
    tenantId  String    @map("tenant_id") @db.Uuid
    companyId String    @map("company_id") @db.Uuid
    name      String
    position  String?
    email     String?
    phone     String?
    mobile    String?
    notes     String?   @db.Text
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz

    tenant  Tenant  @relation(fields: [tenantId], references: [id])
    company Company @relation(fields: [companyId], references: [id])

    @@index([tenantId])
    @@index([companyId])
    @@index([createdAt])
    @@map("contacts")
}

model Pipeline {
    id        String    @id @default(uuid()) @db.Uuid
    tenantId  String    @map("tenant_id") @db.Uuid
    name      String
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz

    tenant Tenant          @relation(fields: [tenantId], references: [id])
    stages PipelineStage[]
    deals  Deal[]

    @@index([tenantId])
    @@map("pipelines")
}

// Ordem sequencial sem duplicidade dentro do mesmo Pipeline (business-rules.md > Pipeline > Ordem).
model PipelineStage {
    id         String              @id @default(uuid()) @db.Uuid
    tenantId   String              @map("tenant_id") @db.Uuid
    pipelineId String              @map("pipeline_id") @db.Uuid
    name       String
    order      Int
    color      String?
    status     PipelineStageStatus @default(ACTIVE)
    createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz
    updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt  DateTime?           @map("deleted_at") @db.Timestamptz

    tenant             Tenant             @relation(fields: [tenantId], references: [id])
    pipeline           Pipeline           @relation(fields: [pipelineId], references: [id])
    deals              Deal[]
    historyEntriesFrom DealStageHistory[] @relation("StageHistoryFrom")
    historyEntriesTo   DealStageHistory[] @relation("StageHistoryTo")

    @@unique([pipelineId, order])
    @@index([tenantId])
    @@index([pipelineId])
    @@map("pipeline_stages")
}

// Toda negociação exige Lead + Empresa + responsável + Pipeline + Etapa (business-rules.md
// > Negociações). leadId é @unique: a conversão de um Lead em negociação é única e
// não-reversível — não pode existir uma segunda negociação para o mesmo Lead.
model Deal {
    id                String     @id @default(uuid()) @db.Uuid
    tenantId          String     @map("tenant_id") @db.Uuid
    leadId            String     @unique @map("lead_id") @db.Uuid
    companyId         String     @map("company_id") @db.Uuid
    responsibleUserId String     @map("responsible_user_id") @db.Uuid
    pipelineId        String     @map("pipeline_id") @db.Uuid
    stageId           String     @map("stage_id") @db.Uuid
    status            DealStatus @default(IN_PROGRESS)
    createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
    updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz

    tenant       Tenant             @relation(fields: [tenantId], references: [id])
    lead         Lead               @relation(fields: [leadId], references: [id])
    company      Company            @relation(fields: [companyId], references: [id])
    responsible  User               @relation(fields: [responsibleUserId], references: [id])
    pipeline     Pipeline           @relation(fields: [pipelineId], references: [id])
    stage        PipelineStage      @relation(fields: [stageId], references: [id])
    stageHistory DealStageHistory[]
    activities   Activity[]

    @@index([tenantId])
    @@index([pipelineId])
    @@index([stageId])
    @@index([status])
    @@index([createdAt])
    @@map("deals")
}

// Log imutável — business-rules.md: "o histórico nunca deverá ser removido". Por isso,
// diferente das demais entidades, não tem updated_at/deleted_at: um registro de histórico
// nunca é alterado nem apagado, só criado (exceção documentada, ver database-patterns.md).
model DealStageHistory {
    id              String   @id @default(uuid()) @db.Uuid
    tenantId        String   @map("tenant_id") @db.Uuid
    dealId          String   @map("deal_id") @db.Uuid
    fromStageId     String?  @map("from_stage_id") @db.Uuid
    toStageId       String   @map("to_stage_id") @db.Uuid
    changedByUserId String   @map("changed_by_user_id") @db.Uuid
    changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz

    tenant    Tenant        @relation(fields: [tenantId], references: [id])
    deal      Deal          @relation(fields: [dealId], references: [id])
    fromStage PipelineStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id])
    toStage   PipelineStage @relation("StageHistoryTo", fields: [toStageId], references: [id])
    changedBy User          @relation(fields: [changedByUserId], references: [id])

    @@index([tenantId])
    @@index([dealId])
    @@map("deal_stage_history")
}

// business-rules.md > Regras Gerais: "Toda atividade pertence a uma negociação ou a um
// Lead" — dealId e leadId são ambos opcionais no schema, mas o service exige exatamente
// um dos dois preenchido (não é uma constraint expressável em Prisma sem SQL bruto).
model Activity {
    id                String         @id @default(uuid()) @db.Uuid
    tenantId          String         @map("tenant_id") @db.Uuid
    dealId            String?        @map("deal_id") @db.Uuid
    leadId            String?        @map("lead_id") @db.Uuid
    responsibleUserId String         @map("responsible_user_id") @db.Uuid
    title             String
    dueDate           DateTime       @map("due_date") @db.Timestamptz
    status            ActivityStatus @default(PENDING)
    createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
    updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz

    tenant      Tenant   @relation(fields: [tenantId], references: [id])
    deal        Deal?    @relation(fields: [dealId], references: [id])
    lead        Lead?    @relation(fields: [leadId], references: [id])
    responsible User     @relation(fields: [responsibleUserId], references: [id])

    @@index([tenantId])
    @@index([dealId])
    @@index([leadId])
    @@index([status])
    @@index([dueDate])
    @@map("activities")
}

// Config por Tenant da integração Meta Lead Ads (business-rules.md > Integração Meta Lead
// Ads). defaultResponsibleUserId existe porque Lead.responsibleUserId é obrigatório no
// schema, mas leads chegados pela integração não têm um usuário autenticado criando-os —
// precisam de um responsável padrão definido pelo próprio Tenant ao habilitar a integração.
model MetaIntegration {
    id                       String                @id @default(uuid()) @db.Uuid
    tenantId                 String                @unique @map("tenant_id") @db.Uuid
    enabled                  Boolean               @default(false)
    pageId                   String?               @map("page_id")
    pageAccessToken          String?               @map("page_access_token")
    defaultResponsibleUserId String?               @map("default_responsible_user_id") @db.Uuid
    duplicateStrategy        DuplicateLeadStrategy @default(IGNORE) @map("duplicate_strategy")
    createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz
    updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt                DateTime?             @map("deleted_at") @db.Timestamptz

    tenant              Tenant @relation(fields: [tenantId], references: [id])
    defaultResponsible  User?  @relation(fields: [defaultResponsibleUserId], references: [id])

    @@index([pageId])
    @@map("meta_integrations")
}

// "Nenhum Lead deverá ser descartado sem registro" (business-rules.md > Integração Meta
// Lead Ads) — cada evento recebido do webhook vira uma linha aqui, atualizada conforme o
// processamento avança (RECEIVED -> PROCESSED/DUPLICATE/FAILED). tenantId é nullable porque
// um evento pode chegar para um page_id que nenhum Tenant configurou — mesmo assim precisa
// ser registrado, não descartado silenciosamente.
model MetaIntegrationLog {
    id           String                    @id @default(uuid()) @db.Uuid
    tenantId     String?                   @map("tenant_id") @db.Uuid
    leadId       String?                   @map("lead_id") @db.Uuid
    leadgenId    String                    @map("leadgen_id")
    pageId       String?                   @map("page_id")
    formId       String?                   @map("form_id")
    adId         String?                   @map("ad_id")
    status       MetaIntegrationLogStatus  @default(RECEIVED)
    errorMessage String?                   @map("error_message") @db.Text
    rawPayload   String                    @map("raw_payload") @db.Text
    createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz
    updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

    tenant Tenant? @relation(fields: [tenantId], references: [id])
    lead   Lead?   @relation(fields: [leadId], references: [id])

    @@index([tenantId])
    @@index([leadgenId])
    @@index([status])
    @@map("meta_integration_logs")
}

// Configuração (por Owner) do formulário de captação de Lead que o Tenant embute no
// próprio site. Mesmo padrão de MetaIntegration: nasce só quando o Owner configura algo
// pela 1ª vez (upsert), não em toda criação de Tenant. requestedFields guarda um
// subconjunto fixo de campos opcionais do Lead ("phone","email","location","cpf",
// "referralSource","notes") — "name" fica de fora porque é sempre coletado.
model TenantWidget {
    id                       String    @id @default(uuid()) @db.Uuid
    tenantId                 String    @unique @map("tenant_id") @db.Uuid
    enabled                  Boolean   @default(false)
    buttonColor              String?   @map("button_color")
    icon                     String?
    defaultResponsibleUserId String?   @map("default_responsible_user_id") @db.Uuid
    requestedFields          String[]  @map("requested_fields")
    createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
    updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz
    deletedAt                DateTime? @map("deleted_at") @db.Timestamptz

    tenant             Tenant @relation(fields: [tenantId], references: [id])
    defaultResponsible User?  @relation(fields: [defaultResponsibleUserId], references: [id])

    @@map("tenant_widgets")
}
